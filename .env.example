# Copy to .env and fill in. Loaded by `make` targets; never commit .env.
# Authentication is NOT configured here: run `gcloud auth application-default login`.
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=US
# Environment prefix of every dataset: dev, prod or pr_<number>
BQ_ENV=dev

# dbt
DBT_TARGET=dev
DBT_PROFILES_DIR=dbt
DBT_PROJECT_DIR=dbt

# Optional: principal granted read access to GOLD (A__grants.sql)
BQ_READER_PRINCIPAL=
# Optional: Slack or Teams incoming webhook for schema drift alerts
SCHEMA_ALERT_WEBHOOK_URL=
